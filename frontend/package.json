        df = df[["date", "value"]].copy()
    elif len(df.columns) >= 2:
        df = df.iloc[:, :2].copy()
        df.columns = ["date", "value"]
    else:
        raise HTTPException(status_code=400, detail="CSV must contain date/value columns")

    result = analyze_trend_from_dataframe(df, date_col="date", value_col="value")
    return result


@app.post("/api/trend/analyze")
async def analyze_json(payload: TrendPayload = Body(...)):
    if not payload.data:
        raise HTTPException(status_code=400, detail="No data provided")
    df = pd.DataFrame(payload.data)
    if "date" not in df.columns or "value" not in df.columns:
        raise HTTPException(status_code=400, detail="Payload must include date and value")
    return analyze_trend_from_dataframe(df, date_col="date", value_col="value")


